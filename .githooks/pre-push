#!/usr/bin/env bash
# push の前に、CI で落ちる多いもの（架构图の check_arch・変えた scripts の試験・生成した網页の JS 文法）を手元で拦める。
# 2026-11-05：係の PR の CI の赤 7 本のうち 5 本が check_arch、#919 は JS の文法で本番の全ページの JS を約 15 分止めた。
# 有効にする：git config core.hooksPath .githooks（worktree も同じ設定を使う）。急ぎで飛ばす：git push --no-verify（使ったら PR に書く）
set -u
# git が hook に渡す変数を、中で流す試験に受け継がせない（2026-11-12：試験の本物の git が本物の repo を書き換えた）
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_PREFIX
cd "$(git rev-parse --show-toplevel)" || exit 0
base=origin/main
git fetch -q origin main 2>/dev/null || true
fail=0
ci_rc=0
# ④（Linux のコンテナで全部の試験）が走る PC か。走るなら ② は ④ に全部含まれるので飛ばす（同じ検査を 2 回やらない）
have_docker=0
docker info >/dev/null 2>&1 && have_docker=1

echo "pre-push ① 架构图（check_arch）"
if ! python3 scripts/check_arch.py "$base"; then
  # 図を変えなくてよい PR は、PR 説明と同じ 1 行「架构图：不用改（理由）」を commit の文に書けば通す（手元からは PR 説明が見えないため）
  if git log --format=%B "$base"..HEAD | grep -q "架构图：不用改"; then echo "（commit の文に「架构图：不用改」があるので通す。PR 説明にも同じ行を書く）"; else fail=1; fi
fi

changed=$(git diff --name-only "$base"...HEAD 2>/dev/null)

tests=""
for f in $(echo "$changed" | grep -E '^(scripts|harness)/[^/]+\.py$'); do
  n=$(basename "$f" .py)
  for t in tests/test_"$n".py tests/test_"$n"_*.py; do [ -f "$t" ] && tests="$tests $t"; done
done
for t in $(echo "$changed" | grep -E '^tests/test_[^/]+\.py$'); do [ -f "$t" ] && tests="$tests $t"; done
if [ -n "$tests" ] && [ "$have_docker" = 1 ]; then
  echo "pre-push ② 飛ばす：④ がコンテナ（Linux）で同じ試験を流すため（④ の組は ② の名前の決まりを含む）"
elif [ -n "$tests" ]; then
  mods=$(echo $tests | tr ' ' '\n' | sort -u | sed 's#/#.#; s#\.py$##' | tr '\n' ' ')
  echo "pre-push ② 変えた所の試験：$mods"
  timeout 600 python3 -m unittest $mods 2>&1 | tail -n 5 || fail=1
  [ "${PIPESTATUS[0]}" = 0 ] || fail=1
fi

if echo "$changed" | grep -qE '^(scripts/render\.py|scripts/welcome\.py|scripts/user_pages\.py)'; then
  # 網页を作り直すと作業ツリーが汚れるので、作り直さずに render の JS の文字列だけを確かめる（生成後の全ページは CI が見る）
  echo "pre-push ③ render の JS の文法（node --check）"
  python3 harness/js_check.py --render || fail=1
fi
if echo "$changed" | grep -qE '^docs/.*\.html$'; then
  echo "pre-push ③ 網页の JS の文法（node --check）"
  python3 harness/js_check.py $(echo "$changed" | grep -E '^docs/.*\.html$') || fail=1
fi

# ④ CI と同じ検査（Linux のコンテナ）。赤い CI を店長に見せない（2026-11-07）。コンテナが動く PC だけ
# 2026-11-13：全部（13 分）ではなく、変わったファイルに当たる試験だけ（harness/affected.py。分からない・harness/・.githooks/・requirements・
# Dockerfile が変わった時は全部）。全部の試験は GitHub の CI が合併の前に必ず流す。手元で全部は `bash harness/ci_local.sh`（引数なし）
# 同じ中身（tree の指紋）で ci_local.sh が 2 時間以内に全部緑なら流さない（係が push の前に流した分。印は ci_local.sh が残す）
green_dir="${HF_CI_GREEN_DIR:-}"
[ -z "$green_dir" ] && [ -d D:/Claude/hf/state ] && green_dir=D:/Claude/hf/state/ci_green
if [ "$fail" = 0 ] && [ "$have_docker" = 1 ]; then
  tree=$(git rev-parse 'HEAD^{tree}' 2>/dev/null)
  stamp_at=""
  [ -n "$green_dir" ] && [ -n "$tree" ] && [ -f "$green_dir/$tree" ] && stamp_at=$(head -n 1 "$green_dir/$tree" 2>/dev/null)
  now=$(date +%s)
  if echo "$stamp_at" | grep -qE '^[0-9]+$' && [ $((now - stamp_at)) -ge 0 ] && [ $((now - stamp_at)) -le "${HF_CI_GREEN_TTL:-7200}" ]; then
    echo "pre-push ④ さっき緑だったので流さない（同じ中身 $tree、$((now - stamp_at)) 秒前）"
  else
    echo "pre-push ④ CI と同じ検査・当たる試験だけ（harness/ci_local.sh --affected）"
    bash harness/ci_local.sh --affected; ci_rc=$?
    # 3 は「負荷の時間切れ」（本物の赤ではない）。丸めずにそのまま返して、係が待って再試行できるようにする
    if [ "$ci_rc" = 3 ]; then fail=3; elif [ "$ci_rc" != 0 ]; then fail=1; fi
  fi
fi

if [ "$fail" != 0 ]; then
  echo "✗ pre-push：上の赤を直してから push（急ぎは --no-verify、そのときは PR に理由を書く）"
  [ "$fail" = 3 ] && { echo "（終了コード 3：負荷の時間切れ。ロックを持ったまま少し待って再試行）"; exit 3; }
  exit 1
fi
echo "✓ pre-push 緑"
